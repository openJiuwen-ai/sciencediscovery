# Copy to `.env.local` (gitignored) or export before `pnpm build`.
# Account service the desktop's sign-in flow talks to. Baked at build time;
# empty means "same origin as this page", which only works when the account
# routes are served by the same host.
VITE_ACCOUNTS_API=https://sciencediscovery.openjiuwen.com/accounts

# Read at runtime by the local API the desktop shell starts, to verify account
# tokens on the loopback bootstrap route. The shell forwards its own value and
# falls back to the same public URL when it is unset; set an empty value to
# disable sign-in.
# SCIENCE_AGENT_ACCOUNTS_URL=https://sciencediscovery.openjiuwen.com/accounts
