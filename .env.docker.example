# Docker Compose settings. Copy to .env (or merge these keys into an existing
# .env) before running `docker compose up`.
#
# Compose reads .env from this directory and interpolates the values into
# docker-compose.yml. The container itself is configured by the `environment`
# block there and by the defaults baked into the Dockerfile — it does not read
# .env from inside the image.

# Owner of the bind-mounted ./data on the host. The container runs as these ids,
# so they must be able to write that directory. Find yours with: id -u ; id -g
SCIENCE_AGENT_UID=1000
SCIENCE_AGENT_GID=1000

# Where the web UI / API is published on the host. 127.0.0.1 keeps it on this
# machine; 0.0.0.0 exposes it to the network — the only auth is the bearer token
# below and there is no TLS, so use trusted networks only.
SCIENCE_AGENT_PUBLISH_HOST=127.0.0.1
SCIENCE_AGENT_PUBLISH_PORT=4310

# Browser/API bearer token. Empty = generated on first start, printed in the
# container log, and stored in /app/data/secrets/auth-token. Set your own value
# before publishing the port beyond loopback.
SCIENCE_AGENT_AUTH_TOKEN=

# Operational logs are persisted through the existing ./data bind mount.
SCIENCE_AGENT_LOG_LEVEL=INFO
SCIENCE_AGENT_LOG_DIR=
SCIENCE_AGENT_LOG_MAX_BYTES=10485760
SCIENCE_AGENT_LOG_BACKUP_COUNT=5

# API → runner token. Stays on container loopback; change it if you prefer.
SCIENCE_AGENT_RUNNER_TOKEN=sciencediscovery-runner-local

# Managed scientific environments. The image carries a pinned, verified
# micromamba binary; creating the starter Python environment still resolves
# packages from the configured channels. Set 0 to disable.
SCIENTIFIC_ENVS=1

# Optional administrator-provided micromamba. Empty uses the verified binary
# baked into the image; a non-empty container path remains authoritative.
SCIENCE_AGENT_PROVISIONER_PATH=

# Wall-clock limit for one sandboxed execution (default 2 hours; 0 = unlimited).
SCIENCE_AGENT_EXEC_TIMEOUT_MS=7200000

# Persistent-kernel idle timeout and allowed package channels.
SCIENCE_AGENT_KERNEL_IDLE_MS=1800000
SCIENCE_AGENT_SCIENTIFIC_CHANNELS=conda-forge

# Optional pre-seeded package cache inside the bind-mounted data directory. The
# entry point creates the directory, but populate it before provisioning because
# setting a non-empty path switches scientific environment setup to offline
# mode. Empty = online provisioning.
SCIENCE_AGENT_PACKAGE_CACHE_DIR=

# The image installs bubblewrap here; override only for a custom image.
SCIENCE_AGENT_BWRAP_PATH=/usr/bin/bwrap

# The image includes OpenSSH. Files placed in host ./data/ssh are already
# available under /app/data/ssh through the existing bind mount, so this example
# needs no extra volume. Add a read-only mount only for paths outside /app/data;
# IdentityFile paths in the config must also be valid inside the container.
# Empty = remote compute is not configured.
SCIENCE_AGENT_SSH_CONFIG_PATH=
