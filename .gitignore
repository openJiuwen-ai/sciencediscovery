# Python environments, caches, and packaging output
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.coverage
.coverage.*
htmlcov/

# Node.js dependencies, caches, and build output
node_modules/
.pnpm-store/
.vite/
dist/
build/
coverage/
*.tsbuildinfo

# Environment files (tracked examples stay available)
.env
.env.*
!.env.example
!.env.docker.example

# Temporary files and logs
.tmp/
.local/
*.log
# packages/provenance falls back to <cwd>/logs when no data directory is
# configured, so the reviewer NDJSON can land next to whichever service ran.
logs/

# Local stack runtime: the repository launcher defaults its data directory
# here, holding service venvs, session data and bootstrap tokens.
/.sciencediscovery-data/

# Local Playwright environment and reports
.e2e/
.e2e-data/
test/node_modules
test/playwright-report/
test/test-results/
# Generated journey step reports (report.md, report.html, step screenshots).
# They normally land in .e2e/journey-reports/; these cover a run started from
# test/ or an E2E_JOURNEY_REPORTS override inside the tree.
test/journey-reports/
journey-reports/

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local worktrees and project tooling caches
.worktrees/

# Note: .agents/ is tracked (project agent skills, e.g. gitcode)
# Local caches under skills (e.g. openJiuwen org issue/PR templates) stay untracked
.agents/skills/gitcode/cache/
