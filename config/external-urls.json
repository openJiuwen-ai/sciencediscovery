  "data_sources": {
    "arxiv": {
      "api_query": "https://export.arxiv.org/api/query",
      "article_template": "https://arxiv.org/abs/{identifier}",
      "pdf_template": "https://arxiv.org/pdf/{identifier}"
    },
    "doi": {
      "canonical_template": "https://doi.org/{doi}",
      "accepted_prefixes": [
        "https://doi.org/",
        "http://doi.org/"
      ]
    },
    "ncbi": {
      "eutils_esearch": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi",
      "eutils_esummary": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi",
      "eutils_elink": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/elink.fcgi",
      "eutils_efetch": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi",
      "pubmed_article_template": "https://pubmed.ncbi.nlm.nih.gov/{pmid}/",
      "accounts_help": "https://www.ncbi.nlm.nih.gov/accounts/",
      "pmc_oa": "https://www.ncbi.nlm.nih.gov/pmc/utils/oa/oa.fcgi",
      "pmc_ftp_https_prefix": "https://ftp.ncbi.nlm.nih.gov/",
      "clinvar_variation_template": "https://www.ncbi.nlm.nih.gov/clinvar/variation/{variation_id}/",
      "geo_accession_template": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc={accession}",
      "geo_series_template": "https://ftp.ncbi.nlm.nih.gov/geo/series/{bucket}/{accession}"
    },
    "europe_pmc": {
      "search_api": "https://www.ebi.ac.uk/europepmc/webservices/rest/search",
      "pmc_article_template": "https://europepmc.org/article/PMC/{identifier}",
      "article_template": "https://europepmc.org/article/{source}/{identifier}",
      "search_template": "https://europepmc.org/search?query=EXT_ID%3A{identifier}"
    },
    "preprints": {
      "details_by_days_template": "https://api.biorxiv.org/details/{server}/{days}d/0/json",
      "details_by_doi_template": "https://api.biorxiv.org/details/{server}/{doi}/na/json",
      "content_template": "https://www.{server}.org/content/{doi}v{version}",
      "pdf_template": "https://www.{server}.org/content/{doi}v{version}.full.pdf"
    },
    "rcsb": {
      "entry_template": "https://data.rcsb.org/rest/v1/core/entry/{identifier}",
      "structure_template": "https://www.rcsb.org/structure/{identifier}",
      "search_api": "https://search.rcsb.org/rcsbsearch/v2/query",
      "download_template": "https://files.rcsb.org/download/{identifier}.{format}"
    },
    "ensembl": {
      "id_template": "https://www.ensembl.org/id/{identifier}",
      "lookup_template": "https://rest.ensembl.org/lookup/id/{identifier}",
      "overlap_template": "https://rest.ensembl.org/overlap/region/{species}/{region}",
      "vep_template": "https://rest.ensembl.org/vep/{species}/id/{identifier}",
      "variation_template": "https://www.ensembl.org/{species}/Variation/Explore?v={identifier}"
    },
    "reactome": {
      "search_api": "https://reactome.org/ContentService/search/query",
      "detail_template": "https://reactome.org/content/detail/{identifier}",
      "data_query_template": "https://reactome.org/ContentService/data/query/{identifier}",
      "analysis_api": "https://reactome.org/AnalysisService/identifiers/projection"
    },
    "chembl": {
      "explore_template": "https://www.ebi.ac.uk/chembl/explore/{kind}/CHEMBL{identifier}",
      "resource_search_template": "https://www.ebi.ac.uk/chembl/api/data/{resource}/search.json",
      "activity_api": "https://www.ebi.ac.uk/chembl/api/data/activity.json",
      "similarity_template": "https://www.ebi.ac.uk/chembl/api/data/similarity/{smiles}/{similarity}.json"
    },
    "uniprot": {
      "api_base": "https://rest.uniprot.org",
      "entry_template": "https://www.uniprot.org/uniprotkb/{accession}/entry"
    },
    "crossref": {
      "works_api": "https://api.crossref.org/works"
    },
    "pubchem": {
      "api_base": "https://pubchem.ncbi.nlm.nih.gov/rest/pug",
      "name_cids_template": "https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/name/{name}/cids/JSON",
      "cid_properties_template": "https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/cid/{cid}/property/{properties}/JSON",
      "resolve_properties_template": "https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/{namespace}/{value}/property/{properties}/JSON",
      "compound_page_template": "https://pubchem.ncbi.nlm.nih.gov/compound/{cid}"
    },
    "afdb": {
      "prediction_template": "https://alphafold.ebi.ac.uk/api/prediction/{accession}",
      "entry_page_template": "https://alphafold.ebi.ac.uk/entry/{accession}"
    },
    "interpro": {
      "entry_api_template": "https://www.ebi.ac.uk/interpro/api/entry/{database}/{accession}",
      "protein_entry_api_template": "https://www.ebi.ac.uk/interpro/api/entry/interpro/protein/uniprot/{accession}",
      "entry_page_template": "https://www.ebi.ac.uk/interpro/entry/{database}/{accession}"
    },
    "optimade": {
      "oqmd_structures_template": "https://oqmd.org/optimade/v1/structures",
      "aflow_structures_template": "https://aflow.org/API/optimade/v1/structures",
      "cod_structures_template": "https://www.crystallography.net/cod/optimade/v1/structures",
      "mp_structures_template": "https://optimade.materialsproject.org/v1/structures",
      "cod_entry_page_template": "https://www.crystallography.net/cod/{identifier}.html",
      "mp_entry_page_template": "https://materialsproject.org/materials/{identifier}",
      "oqmd_materials_page": "https://oqmd.org/materials",
      "aflow_home_page": "https://aflow.org"
    },
    "string": {
      "network_api": "https://string-db.org/api/json/network",
      "resolve_api": "https://string-db.org/api/json/get_string_ids",
      "network_page_template": "https://string-db.org/network/{taxon}/{identifiers}"
    },
    "biogrid": {
      "interactions_api": "https://webservice.thebiogrid.org/interactions",
      "home_page": "https://thebiogrid.org"
    },
    "gnomad": {
      "graphql_api": "https://gnomad.broadinstitute.org/api",
      "gene_page_template": "https://gnomad.broadinstitute.org/gene/{gene_id}",
      "variant_page_template": "https://gnomad.broadinstitute.org/variant/{variant_id}"
    },
    "gwas": {
      "associations_api": "https://www.ebi.ac.uk/gwas/rest/api/v2/associations",
      "search_page_template": "https://www.ebi.ac.uk/gwas/search?query={query}"
    },
    "gtopdb": {
      "targets_api": "https://www.guidetopharmacology.org/services/targets",
      "ligands_api": "https://www.guidetopharmacology.org/services/ligands",
      "ligand_interactions_template": "https://www.guidetopharmacology.org/services/ligands/{ligand_id}/interactions",
      "target_page_template": "https://www.guidetopharmacology.org/GRAC/ObjectDisplayForward?objectId={target_id}",
      "ligand_page_template": "https://www.guidetopharmacology.org/GRAC/LigandDisplayForward?ligandId={ligand_id}"
    },
    "kegg": {
      "find_template": "https://rest.kegg.jp/find/{database}/{query}",
      "get_template": "https://rest.kegg.jp/get/{entry}",
      "link_template": "https://rest.kegg.jp/link/{target_db}/{source}",
      "entry_page_template": "https://www.kegg.jp/entry/{entry}"
    },
    "pride": {
      "search_projects_api": "https://www.ebi.ac.uk/pride/ws/archive/v2/search/projects",
      "project_api_template": "https://www.ebi.ac.uk/pride/ws/archive/v2/projects/{accession}",
      "project_files_api_template": "https://www.ebi.ac.uk/pride/ws/archive/v2/projects/{accession}/files",
      "project_page_template": "https://www.ebi.ac.uk/pride/archive/projects/{accession}"
    },
    "wikidata": {
      "sparql_endpoint": "https://query.wikidata.org/sparql",
      "entity_page_template": "https://www.wikidata.org/wiki/{entity}"
    },
    "datacite": {
      "dois_api": "https://api.datacite.org/dois",
      "doi_api_template": "https://api.datacite.org/dois/{doi}",
      "doi_url_template": "https://doi.org/{doi}"
    }
