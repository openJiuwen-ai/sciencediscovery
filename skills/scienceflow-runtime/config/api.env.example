# Example only. NEVER put real tokens in a published Skill or Git repository.
# Store your real copy at ~/.config/scienceflow-runtime/api.env (chmod 600).
SF_MODEL=replace-with-your-model-id
SF_BASE_URL=https://your-openai-compatible-endpoint.example/v1
SF_API_KEY=replace-with-your-secret
# If feedback uses another endpoint/model, uncomment:
# SF_FEEDBACK_MODEL=replace-with-feedback-model-id
# SF_FEEDBACK_BASE_URL=https://your-feedback-endpoint.example/v1
# SF_FEEDBACK_API_KEY=replace-with-feedback-key
# Only use proxy when your provider requires it; ensure proxy env vars are set.
SF_USE_PROXY=false
