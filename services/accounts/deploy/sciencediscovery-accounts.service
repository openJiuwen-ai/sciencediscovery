# ScienceDiscovery accounts service (systemd)
#
# Install:
#   sudo cp sciencediscovery-accounts.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sciencediscovery-accounts
#
# The service listens on 127.0.0.1:4400 only; nginx terminates TLS in front of
# it. Binding a public interface here would expose plain HTTP past the proxy.

[Unit]
Description=ScienceDiscovery accounts API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sciencediscovery
Group=sciencediscovery
WorkingDirectory=/opt/sciencediscovery/accounts
EnvironmentFile=/etc/sciencediscovery/accounts.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=3
TimeoutStopSec=20

# The process only needs to write nothing but its own temp files.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
