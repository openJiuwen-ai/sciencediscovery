# /etc/sciencediscovery/accounts.env
# chmod 600, owner root; systemd reads it as the service user.
# Empty values are not defaulted for the required keys: the service refuses to
# start rather than silently downgrading auth or database access.

# RDS Supabase 的 Supavisor 内网连接串（ECS 与实例需在同一 VPC）
DATABASE_URL=postgres://user:password@host:5432/postgres

# 至少 32 字节；生成：openssl rand -base64 48
JWT_SECRET=

# LLM 代理调用 /internal/billing/* 的共享密钥；留空则计费接口整体关闭
BILLING_TOKEN=

# 华为账号 OAuth 应用。PKCE / 公共客户端可以不配置 Secret。
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
# 与华为后台登记的授权回调地址逐字一致，token 交换要用它
HUAWEI_REDIRECT_URI=https://accounts.example.com/v1/auth/huawei/callback

# 浏览器回调落点与允许的后台来源
WEB_RETURN_URL=https://app.example.com/login
ADMIN_ORIGIN=https://admin.example.com
# 桌面端本地 UI 的 Origin，多个用逗号分隔，可写端口通配 http://127.0.0.1:*
WEB_ORIGINS=http://127.0.0.1:4310

# 后台 Cookie 的 Domain；留空即 Host-only
ADMIN_COOKIE_DOMAIN=
COOKIE_SECURE=true

# 只监听本机，由 nginx 反代；调试时才改成 0.0.0.0
HOST=127.0.0.1
PORT=4400

# 个人额度：1 积分 = 0.08 元。每日签到长期有效，累计签到每满 7 天加 50 积分。
REGISTER_GRANT_CREDITS=500
# 签到金额和周期只接受十进制非负整数（如 0、100）。请删除未使用的变量以采用默认值，勿留空。
# 不支持 +5、1e3 或小数。CHECKIN_BONUS_EVERY_DAYS 未设置时仍可使用旧名 DAILY_REWARD_DAYS。
DAILY_REWARD_CREDITS=100
CHECKIN_BONUS_EVERY_DAYS=7
STREAK_BONUS_CREDITS=50
