{
  "name": "@sciencediscovery/accounts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test src/crypto.test.ts src/http.test.ts src/huawei.test.ts src/pricing.test.ts src/app.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema": "tsx src/cli/schema.ts",
    "schema:sql": "tsx src/cli/schema.ts --print",
    "init-admin": "tsx src/cli/init-admin.ts"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.15.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
