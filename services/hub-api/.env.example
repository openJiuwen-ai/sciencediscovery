# Copy to .env and fill in. Never commit .env.

# ── Database ──
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=hub
MYSQL_USER=hub
MYSQL_PASSWORD=change-me-too

# ── Object storage (Huawei Cloud OBS, private bucket) ──
HUB_S3_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
HUB_S3_REGION=cn-north-4
HUB_S3_BUCKET=sciencediscovery-hub
HUB_S3_ACCESS_KEY=
HUB_S3_SECRET_KEY=

# ── Sessions ──
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
HUB_SESSION_SECRET=

# ── Accounts ──
HUB_ALLOW_REGISTRATION=false
HUB_ADMIN_USERNAME=admin
HUB_ADMIN_PASSWORD=

# ── Downloads ──
HUB_PRESIGN_SECONDS=600
