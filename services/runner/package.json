{
  "name": "@sciencediscovery/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-version.mjs",
    "start": "node dist/server.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sciencediscovery/cas": "workspace:*",
    "@sciencediscovery/operational-logging": "workspace:*",
    "@sciencediscovery/sandbox-capability": "workspace:*",
    "@sciencediscovery/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
