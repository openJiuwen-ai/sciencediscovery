# OpenAI-compatible chat completions endpoint. Used only by the real-model
# smoke tests (test/gateway/run_real_smoke.sh, test/api/run_real_smoke.sh);
# the application itself takes model profiles from the Model registry.
SCIENCE_AGENT_LLM_BASE_URL=https://api.openai.com/v1
SCIENCE_AGENT_LLM_MODEL=gpt-4o-mini
SCIENCE_AGENT_LLM_API_TOKEN=

# Optional package mirrors for the start-stack.sh build step. Scoped to the
# script's install commands (pnpm --registry / UV_DEFAULT_INDEX); user and
# global npm/uv config are never touched. Example (Huawei Cloud):
# SCIENCE_AGENT_NPM_REGISTRY=https://mirrors.huaweicloud.com/repository/npm/
# SCIENCE_AGENT_PYPI_INDEX=https://mirrors.huaweicloud.com/repository/pypi/simple

# Single runtime root: all state AND the uv-managed Python service
# environments (envs/paper, envs/gateway) live under this directory, so
# changing it relocates everything together. Gitignored; relative paths
# resolve from the repository root.
SCIENCE_DISCOVERY_DATA_DIR=.sciencediscovery-data

# Size-rotated operational logs. Empty LOG_DIR means <data dir>/logs.
# Categories include api.log, run.log, gateway.log, runner.log, and (when
# enabled) memory-graph.log. Logs contain event metadata and correlation keys,
# not prompts, tool output, request bodies, or credentials.
SCIENCE_AGENT_LOG_LEVEL=INFO
SCIENCE_AGENT_LOG_DIR=
SCIENCE_AGENT_LOG_MAX_BYTES=10485760
SCIENCE_AGENT_LOG_BACKUP_COUNT=5

# HTTP control plane. Loopback by default: the bearer token is the only
# authentication and the service does not terminate TLS. Set another address
# only for an explicitly secured, trusted deployment.
#
# There is no default token. Leave SCIENCE_AGENT_AUTH_TOKEN empty and the first
# start generates a random one, prints it, and stores it in
# <data dir>/secrets/auth-token for every later start. Set it to pin your own
# value instead; an explicit value always wins over the stored one.
SCIENCE_AGENT_HOST=127.0.0.1
SCIENCE_AGENT_PORT=4310
SCIENCE_AGENT_AUTH_TOKEN=
# Static UI assets served by the API.
SCIENCE_AGENT_WEB_DIR=apps/web/dist

# Interpreter for the bundled Python MCP servers (biomed, UniProt), which the
# API spawns over stdio. Empty = <data dir>/envs/gateway/bin/python.
SCIENCE_AGENT_GATEWAY_PYTHON_PATH=

# Product timeout seeds for the agent loop, used only until global timeout
# settings are persisted. 0 means unlimited. The names keep their GATEWAY_
# prefix for compatibility with existing .env files; the loop they bound now
# runs inside this API process. The settings remain editable in System
# configuration.
SCIENCE_AGENT_GATEWAY_IDLE_TIMEOUT_MS=240000
SCIENCE_AGENT_GATEWAY_TURN_TIMEOUT_MS=0
# Wall-clock limit for one sandboxed execution.
SCIENCE_AGENT_EXEC_TIMEOUT_MS=0
# Permission-decision wait.
SCIENCE_AGENT_PERMISSION_WAIT_TIMEOUT_MS=0
# Persistent-kernel idle timeout.
SCIENCE_AGENT_KERNEL_IDLE_MS=0

# Remote compute reuses explicit Host aliases, keys, and policy from the user's
# OpenSSH configuration. Empty = ~/.ssh/config.
SCIENCE_AGENT_SSH_CONFIG_PATH=

# M1 isolated runner. Keep the runner on loopback; the API is its only client.
SCIENCE_AGENT_RUNNER_HOST=127.0.0.1
SCIENCE_AGENT_RUNNER_PORT=4311
SCIENCE_AGENT_RUNNER_URL=http://127.0.0.1:4311
SCIENCE_AGENT_RUNNER_TOKEN=sciencediscovery-runner-local
# bubblewrap binary, resolved from PATH by default.
SCIENCE_AGENT_BWRAP_PATH=bwrap

# Host NPU Broker. The Runner keeps normal bwrap isolation for sandbox tools and
# runs allowlisted NPU workloads on the host side. Workloads are loaded from a
# JSON allowlist; omit SCIENCE_AGENT_NPU_WORKLOAD_CONFIG to use the repo default
# at services/runner/workloads/npu-workloads.default.json.
SCIENCE_AGENT_NPU_BROKER=0
SCIENCE_AGENT_NPU_WORKLOAD_CONFIG=
# Compatibility fallback only for custom workload allowlists that use
# ${python}. Built-in NPU workloads use the current ScienceDiscovery managed
# scientific environment revision instead.
SCIENCE_AGENT_NPU_PYTHON=
SCIENCE_AGENT_NPU_SMOKE_SCRIPT=
# Protenix manager entrypoint supplied by the deployed antibody/Protenix skill bundle.
SCIENCE_AGENT_NPU_PROTENIX_SCRIPT=

# Memory graph (services/memory-graph, loopback only). The graph is a passive
# mirror of execution state; the API stays the system of record. The feature
# is still partial (only SubTask/Code/Artifact nodes + the observeExecution
# hook are wired). There is no ENABLED switch here — turn it on/off and set
# the Neo4j password in System Settings → Memory graph (encrypted, stored by
# the backend). This block only holds non-sensitive connection defaults.
SCIENCE_AGENT_MEMORY_GRAPH_HOST=127.0.0.1
SCIENCE_AGENT_MEMORY_GRAPH_PORT=17674
SCIENCE_AGENT_MEMORY_GRAPH_URL=http://127.0.0.1:17674
SCIENCE_AGENT_MEMORY_GRAPH_INTERNAL_TOKEN=sciencediscovery-memory-graph-local
SCIENCE_AGENT_MEMORY_GRAPH_LOG_LEVEL=INFO
# Neo4j HTTP endpoint and user are configured in System Settings → Memory graph
# (stored encrypted; pushed to the sidecar at save time).

# Scientific environments are configured from System Settings. The application
# downloads its pinned provisioner and owns every Python/R prefix under data/.
# Only this authenticated provisioning workflow may use network access; agent
# Python/R execution remains network-denied inside its own sandbox namespace.
SCIENTIFIC_ENVS=1
# Comma-separated package channel allowlist.
SCIENCE_AGENT_SCIENTIFIC_CHANNELS=conda-forge
# Optional air-gapped/admin overrides. Empty = the pinned application-owned
# provisioner. A non-empty cache path switches provisioning to offline mode.
SCIENCE_AGENT_PROVISIONER_PATH=
SCIENCE_AGENT_PACKAGE_CACHE_DIR=

# PDF worker. Empty python path = <data dir>/envs/paper/bin/python (created by
# the run script).
SCIENCE_AGENT_PAPER_PYTHON_PATH=
SCIENCE_AGENT_PAPER_WORKER_PATH=services/paper/paper_worker.py

# Session workspace multipart upload limits and filename validation.
# Per-file upload default is 1 GiB; multipart request default is 10 GiB; 0 = unlimited.
# SCIENCE_AGENT_WORKSPACE_UPLOAD_MAX_FILE_BYTES=1073741824
# SCIENCE_AGENT_WORKSPACE_UPLOAD_MAX_REQUEST_BYTES=10737418240
# Upload + runner workspace total default is 10 GiB; 0 = unlimited.
# SCIENCE_AGENT_WORKSPACE_MAX_BYTES=10737418240
# SCIENCE_AGENT_MAX_WORKSPACE_BYTES=10737418240
# Retained stdout+stderr per execution; default 1 GiB; 0 = no truncation.
# SCIENCE_AGENT_MAX_OUTPUT_BYTES=1073741824
