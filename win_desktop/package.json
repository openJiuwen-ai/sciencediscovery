{
  "name": "sd-shell",
  "version": "0.3.0",
  "private": true,
  "author": "ScienceDiscovery",
  "description": "ScienceDiscovery Windows desktop shell (Electron). Loads the SD web UI, injects the local access token, owns the backend stack lifecycle.",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/build.mjs && electron .",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "make-icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "assemble": "node scripts/assemble-backend.mjs",
    "dist": "node scripts/build.mjs && node scripts/assemble-backend.mjs && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
