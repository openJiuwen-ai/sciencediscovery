diff --git a/templates/nsis/include/extractAppPackage.nsh b/templates/nsis/include/extractAppPackage.nsh
index f5470bf52e923dc47266cea4684c76ef78ced451..f1d0da40eb65e343eed34b1a9ead6fe8afa2f673 100644
--- a/templates/nsis/include/extractAppPackage.nsh
+++ b/templates/nsis/include/extractAppPackage.nsh
@@ -6,6 +6,33 @@
   Var /GLOBAL packageArch
   
   !insertmacro identify_package
+
+  # Phase ② — THE one visible bar run. ⓪/① collapse the bar control to
+  # 0x0 (the runtime's forced SHOW during File instructions cannot restore
+  # a zero size, which SW_HIDE never survived). This is the longest phase
+  # of the install (~2:48 field data), so re-inflate the control from the
+  # saved rect right before Nnis7z takes over and drives it monotonically
+  # 0→100%. Phase ③ collapses it again. No narration: the window title
+  # stays at the stock install title; nothing else narrates the
+  # phases to the user.
+  !ifndef ONE_CLICK
+    ${IfNot} ${Silent}
+      FindWindow $0 "#32770" "" $HWNDPARENT
+      GetDlgItem $0 $0 1006
+      StrCpy $2 $sdBarX
+      StrCpy $3 $sdBarY
+      StrCpy $4 $sdBarW
+      StrCpy $5 $sdBarH
+      System::Call 'user32::SetWindowPos(p r0, p 0, i r2, i r3, i r4, i r5, i 0x14)'
+      ShowWindow $0 ${SW_SHOW}
+      # Remove the default gray track: disable themes so color
+      # messages take effect, then set green bar on white background.
+      System::Call 'uxtheme::SetWindowTheme(p r0, t "", t "") i .r6'
+      SendMessage $0 0x409 0 0x00AA00
+      SendMessage $0 0x406 0 0xFFFFFF
+    ${endif}
+  !endif
+
   !insertmacro compute_files_for_current_arch
 
   !ifdef COMPRESS
@@ -90,6 +117,22 @@
 !macroend
 
 !macro extractUsing7za FILE
+  # Fast path: extract straight into $OUTDIR (= $INSTDIR at this point).
+  # The stock flow below extracts the whole
+  # payload to $PLUGINSDIR\7z-out and then CopyFiles's it to the install dir
+  # — a silent SECOND full write (ScienceDiscovery ships ~1.7GB / 75k files:
+  # minutes of extra I/O plus a second AV pass) with near-zero progress-bar
+  # coverage: observed in the field, bar frozen at ~75% for the whole copy
+  # then a jump to done, and non-monotonic "multi-round" bar behavior.
+  # CHECK_APP_RUNNING has already run, so the target is not in use. Nsis7z
+  # pushes no result (stock's "Pop $R0" retrieves its own "Push $OUTDIR"),
+  # so nothing needs popping here. If the main exe did not land (partial
+  # failure / locked file corner case), fall through to the stock flow,
+  # kept verbatim below.
+  Nsis7z::Extract "${FILE}"
+  IfFileExists "$OUTDIR\${APP_EXECUTABLE_FILENAME}" DoneExtract7za 0
+
+  # --- stock flow (unchanged fallback) ---
   Push $OUTDIR
   CreateDirectory "$PLUGINSDIR\7z-out"
   ClearErrors
diff --git a/templates/nsis/installSection.nsh b/templates/nsis/installSection.nsh
index 053772f55ca6ece52f0a34c4fa0f05c9a5f07bd2..1190f2f4f77ea79071bbfca7d5885b4777a8044d 100644
--- a/templates/nsis/installSection.nsh
+++ b/templates/nsis/installSection.nsh
@@ -3,11 +3,77 @@
 InitPluginsDir
 
 ${IfNot} ${Silent}
-  SetDetailsPrint none
+  # MUST stay listonly — with none the NSIS runtime re-inflates
+  # the collapsed InstFiles bar during File instructions (observed in the
+  # field: phase-① bar visible 450px, 0→20155 in ~30s, and the ③ tail bar
+  # too). listonly keeps the collapse alive (proven in the field); the
+  # details view is left collapsed (no SetDetailsView show), so the file
+  # lines are written but never shown to the user.
+  SetDetailsPrint listonly
 ${endif}
 
 StrCpy $appExe "$INSTDIR\${APP_EXECUTABLE_FILENAME}"
 
+# One-bar install progress (only the longest run is visible). Field
+# data: the NSIS runtime force-SHOWs and drives the InstFiles bar during
+# File instructions and Nnis7z drives it during extraction — SW_HIDE
+# never survives either, so earlier phases leaked short visible bar runs
+# (① ~19s write blip, ③ tail blip) around the one run that matters.
+# New contract:
+#   ⓪ old-version removal — bar collapsed to 0x0 (a forced SHOW cannot
+#      restore the size);
+#   ① data materialization (fast, ~19s) — bar stays collapsed;
+#   ② main extraction (the longest run, ~2:48) — THE one visible bar:
+#      re-inflated just before Nnis7z takes over (see extractAppPackage),
+#      monotonic 0→100%;
+#   ③ registry/shortcut tail — collapsed again.
+# No phase narration: the window title stays at the stock install
+# title and the InstFiles page keeps its stock localized "installing"
+# text — only the ② bar run speaks; the other phases stay
+# completely silent.
+Var /GLOBAL sdBarX
+Var /GLOBAL sdBarY
+Var /GLOBAL sdBarW
+Var /GLOBAL sdBarH
+Var /GLOBAL sdMarquee
+!ifndef ONE_CLICK
+  ${IfNot} ${Silent}
+    FindWindow $1 "#32770" "" $HWNDPARENT
+    GetDlgItem $0 $1 1006
+    # Remember the bar's rect (client coords of the #32770 dialog) — the ②
+    # restore in extractAppPackage.nsh needs it in BOTH branches below.
+    System::Call '*(i, i, i, i) i .r2'
+    System::Call 'user32::GetWindowRect(p r0, p r2)'
+    System::Call 'user32::MapWindowPoints(p 0, p r1, p r2, i 2)'
+    System::Call '*$2(i .r3, i .r4, i .r5, i .r6)'
+    System::Free $2
+    StrCpy $sdBarX $3
+    StrCpy $sdBarY $4
+    IntOp $sdBarW $5 - $3
+    IntOp $sdBarH $6 - $4
+    # Two-bar upgrade — show the old-version removal AND the install:
+    #   upgrade → marquee bar for ⓪ (the old uninstaller is a separate
+    #             process, no real percentage is observable — a scrolling
+    #             marquee says "working, unknown duration"), collapse before ①;
+    #   fresh   → collapse to 0x0 right away (only the ② bar run is visible).
+    # Field builds proved that 0x0 collapse works as long as SetDetailsView
+    # show is kept (installer.nsh preInit); without it the NSIS runtime
+    # re-inflates the bar during File instructions (reproduced on every
+    # field build that dropped it).
+    ReadRegStr $9 SHELL_CONTEXT "${UNINSTALL_REGISTRY_KEY}" "UninstallString"
+    ${If} $9 != ""
+      StrCpy $sdMarquee "1"
+      System::Call 'user32::GetWindowLongW(p r0, i -16) i .r6'
+      IntOp $6 $6 | 8
+      System::Call 'user32::SetWindowLongW(p r0, i -16, i r6)'
+      SendMessage $0 0x040A 1 60
+    ${Else}
+      StrCpy $sdMarquee "0"
+      System::Call 'user32::SetWindowPos(p r0, p 0, i 0, i 0, i 0, i 0, i 0x16)'
+    ${EndIf}
+  ${endif}
+!endif
+
