@@ -57,6 +123,23 @@ ${if} $installMode == "all"
   !insertmacro handleUninstallResult HKEY_CURRENT_USER
 ${endIf}
 
+# ⓪ done — stop the marquee, strip PBS_MARQUEE (a marquee-styled
+# bar ignores PBM_SETPOS, so ①'s runtime ticks and ②'s Nnis7z drive would be
+# swallowed), then collapse the bar to 0x0 for ①. Fresh installs are already
+# collapsed and skip this via $sdMarquee.
+!ifndef ONE_CLICK
+  ${If} $sdMarquee == "1"
+  ${AndIfNot} ${Silent}
+    FindWindow $1 "#32770" "" $HWNDPARENT
+    GetDlgItem $0 $1 1006
+    SendMessage $0 0x040A 0 0
+    System::Call 'user32::GetWindowLongW(p r0, i -16) i .r6'
+    IntOp $6 $6 & 0xFFFFFFF7
+    System::Call 'user32::SetWindowLongW(p r0, i -16, i r6)'
+    System::Call 'user32::SetWindowPos(p r0, p 0, i 0, i 0, i 0, i 0, i 0x16)'
+  ${EndIf}
+!endif
+
 SetOutPath $INSTDIR
 
