+def update_permissions_tools_in_config(tools: Any) -> dict[str, Any]:
+    """Merge a validated permission batch in one locked config transaction."""
+    normalized = _validate_tools_map(tools)
+
+    def mutate(data):
+        permissions = data.setdefault("permissions", {})
+        existing = permissions.get("tools")
+        merged = dict(existing) if isinstance(existing, dict) else {}
+        merged.update(normalized)
+        if merged == existing or not normalized:
+            return None
+        permissions["tools"] = merged
+        return data
+
+    data = update_config(mutate)
+    return {"tools": dict((data.get("permissions") or {}).get("tools") or {})}
+
+
+def delete_permissions_tools_in_config(tools: Any) -> dict[str, Any]:
+    """Remove only the named tools in one transaction; absent names are safe to retry."""
+    if not isinstance(tools, list) or any(not isinstance(name, str) or not name.strip() for name in tools):
+        raise ValueError("tools must be a list of non-empty tool names")
+    names = {name.strip() for name in tools}
+
+    def mutate(data):
+        permissions = data.get("permissions") or {}
+        existing = permissions.get("tools")
+        if not isinstance(existing, dict):
+            return None
+        retained = {key: value for key, value in existing.items() if str(key).strip() not in names}
+        if len(retained) == len(existing):
+            return None
+        permissions["tools"] = retained
+        return data
+
+    data = update_config(mutate)
+    return {"tools": dict((data.get("permissions") or {}).get("tools") or {})}
 
 
