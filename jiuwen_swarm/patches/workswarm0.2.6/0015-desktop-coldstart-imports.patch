+    "AcpChannel": ".protocol.acp.acp_connect",
+    "AcpChannelConfig": ".protocol.acp.acp_connect",
+}
+
+
+def __getattr__(name: str) -> Any:
+    src = _EXPORTS.get(name)
+    if src is not None:
+        import importlib
+
+        module = importlib.import_module(f"jiuwenswarm.gateway.channel_manager{src}", __package__)
+        value = getattr(module, name)
+        globals()[name] = value  # cache so subsequent lookups skip __getattr__
+        return value
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+
+def __dir__() -> list[str]:
+    return sorted(set(list(globals()) + list(_EXPORTS)))
