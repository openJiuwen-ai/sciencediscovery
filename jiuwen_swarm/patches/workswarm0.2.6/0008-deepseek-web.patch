+++ b/jiuwenswarm/agents/harness/common/tools/deepseek_web.py
@@ -0,0 +1,142 @@
+# Copyright (C) 2026 Huawei Technologies Co., Ltd
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in DeepSeek tools for the pinned Swarm runtime and its MCP toolkit."""
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+from urllib.parse import urlsplit
+
+import requests
+from openjiuwen.harness.tools import WebPaidSearchTool as _CorePaidSearch
+from openjiuwen.harness.tools import WebFetchWebpageTool as _CoreFetch
+from openjiuwen.harness.tools.web._common import _domain_allowed
+
+
+def _flag(name: str) -> bool:
+    return os.environ.get(name, "").strip().lower() in {"true", "1", "yes", "on"}
+
+
+def deepseek_search_enabled() -> bool:
+    return _flag("DEEPSEEK_SEARCH_ENABLED") and bool(os.environ.get("DEEPSEEK_API_KEY", "").strip())
+
+
+def is_paid_search_enabled() -> bool:
+    return deepseek_search_enabled() or any(
+        os.environ.get(name + "_API_KEY", "").strip()
+        for name in ("BOCHA", "PERPLEXITY", "SERPER", "JINA")
+    )
+
+
+def _request(operation: str, payload: dict, timeout: float, proxy_url=None) -> dict:
+    if not _flag(f"DEEPSEEK_{operation.upper()}_ENABLED"):
+        raise ValueError("DeepSeek is disabled in Web settings (PROVIDER_DISABLED).")
+    key = os.environ.get("DEEPSEEK_API_KEY", "").strip()
+    if not key:
+        raise ValueError("Configure a DeepSeek API key in Web settings (MISSING_CREDENTIALS).")
+    endpoint = os.environ.get(f"DEEPSEEK_{operation.upper()}_URL", "").strip() or f"https://api.deepseek.com/v1/tools/{operation}"
+    try:
+        with requests.post(
+            endpoint, json=payload,
+            headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
+            timeout=timeout, stream=True, allow_redirects=False,
+            **({"proxies": {"http": proxy_url, "https": proxy_url}} if proxy_url else {}),
+        ) as response:
+            status = response.status_code
+            if status != 200:
+                code, reason = {
+                    401: ("UNAUTHORIZED", "authentication failed; check your API key"),
+                    402: ("INSUFFICIENT_BALANCE", "insufficient balance; top up your account"),
+                    429: ("RATE_LIMITED", "rate limit exceeded; retry after the cooldown"),
+                    408: ("TIMEOUT", "request timed out"),
+                    504: ("TIMEOUT", "request timed out"),
+                    404: ("FETCH_FAILED", "could not retrieve usable Markdown from this page"),
+                }.get(status, ("PROVIDER_ERROR", "request failed"))
+                raise ValueError(f"DeepSeek {operation}: {reason} (HTTP {status}, {code}).")
+            chunks, size = [], 0
+            for chunk in response.iter_content(65536):
+                size += len(chunk)
+                if size > 1_000_000:
+                    raise ValueError("DeepSeek response exceeds 1 MB (PROVIDER_ERROR).")
+                chunks.append(chunk)
+            data = json.loads(b"".join(chunks))
+            if not isinstance(data, dict):
+                raise ValueError("DeepSeek returned an invalid response (PROVIDER_ERROR).")
+            return data
+    except requests.Timeout:
+        raise ValueError("DeepSeek request timed out (TIMEOUT).") from None
+    except requests.RequestException:
+        # Transport exceptions can contain proxy credentials; never return them to the model.
+        raise ValueError("DeepSeek could not be reached (UPSTREAM_UNAVAILABLE).") from None
+
+
+def deepseek_search(query: str, max_results: int = 8, timeout_seconds: float = 45, proxy_url=None) -> dict:
+    query = str(query or "").strip()
+    if not query or len(query) > 128:
+        raise ValueError("DeepSeek query must contain 1 to 128 Unicode characters (INVALID_INPUT).")
+    data = _request("search", {"query": query, "count": max(1, min(int(max_results), 50))}, timeout_seconds, proxy_url)
+    rows = data.get("results")
+    if not isinstance(rows, list):
+        raise ValueError("DeepSeek search response is missing results (PROVIDER_ERROR).")
+    lines, urls = [], []
+    for row in rows[:max_results]:
+        if not isinstance(row, dict) or not isinstance(row.get("url"), str):
+            continue
+        urls.append(row["url"])
+        lines.append(f"{len(urls)}. {row.get('title', '')}\n   URL: {row['url']}\n   Summary: {row.get('summary') or row.get('snippet') or ''}")
+    return {"provider": "deepseek", "answer": "\n".join(lines), "urls": urls}
+
+
+def deepseek_fetch(url: str, timeout_seconds: float = 30, proxy_url=None) -> dict:
+    parsed = urlsplit(url)
+    if len(url) > 8192 or parsed.scheme not in {"http", "https"} or not parsed.hostname or parsed.username or parsed.password:
+        raise ValueError("DeepSeek fetch requires an HTTP(S) URL without credentials (INVALID_INPUT).")
+    data = _request("fetch", {"url": url}, timeout_seconds, proxy_url)
+    if not isinstance(data.get("content"), str) or not data["content"].strip():
+        raise ValueError("DeepSeek returned no usable Markdown content (FETCH_FAILED).")
+    return {"url": url, "status_code": 200, "title": data.get("title", ""), "content": data["content"]}
+
+
+class WebPaidSearchTool(_CorePaidSearch):
+    """Keep agent-core providers intact and append DeepSeek to auto fallback."""
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        if deepseek_search_enabled():
+            self.card.input_params["properties"]["provider"]["enum"].append("deepseek")
+            self.card.description += " DeepSeek Search is also configured; auto tries it after the other paid providers."
+
+    async def invoke(self, inputs, **kwargs):
+        provider = str(inputs.get("provider", "auto") or "auto").strip().lower()
+        if provider != "deepseek":
+            result = await super().invoke(inputs, **kwargs)
+            if provider != "auto" or not deepseek_search_enabled() or not result.startswith("[ERROR]"):
+                return result
+        try:
+            data = await asyncio.to_thread(
+                deepseek_search, str(inputs.get("query", "")),
+                max(1, min(int(inputs.get("max_results", 8) or 8), 20)),
+                max(1, min(float(inputs.get("timeout_seconds", 45) or 45), 120)), self._proxy_url,
+            )
+            if not data["urls"]:
+                return "No search results for this query. Try different search terms or free_search."
+            return "Paid search provider: deepseek\nAnswer:\n" + data["answer"] + "\nURLs:\n" + "\n".join(f"{i}. {url}" for i, url in enumerate(data["urls"], 1))
+        except Exception as exc:
+            return f"[ERROR]: {exc}"
+
+
+class WebFetchWebpageTool(_CoreFetch):
+    """Use the existing fetch path unless DeepSeek is explicitly selected."""
+    async def invoke(self, inputs, **kwargs):
+        if not _flag("DEEPSEEK_FETCH_ENABLED"):
+            return await super().invoke(inputs, **kwargs)
+        try:
+            url = self._normalize_url(str(inputs.get("url", "") or ""))
+            if self._allowed_domains and not _domain_allowed(url, self._allowed_domains):
+                raise ValueError("URL is outside the configured domestic academic source domains")
+            data = await asyncio.to_thread(deepseek_fetch, url,
+                max(1, min(float(inputs.get("timeout_seconds", 30) or 30), 120)), self._proxy_url)
+            content = self._clip_text(data["content"], max(0, int(inputs.get("max_chars", 0) or 0)))
+            return f"URL: {url}\nStatus: 200\nTitle: {data['title']}\nContent:\n{content}"
+        except Exception as exc:
+            return f"[ERROR]: {exc}"
