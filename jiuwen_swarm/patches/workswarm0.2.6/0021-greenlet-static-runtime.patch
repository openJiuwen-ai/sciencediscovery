# [windows-desktop] greenlet 3.3.1–3.5.4 Windows wheels dynamically link
# MSVCP140.dll (VC++ x64 redistributable). 3.5.5 restored the static C++
# runtime. The pinned upstream tag allows >=3.3.2,<4, so uv.lock resolves
# 3.5.0 and the packaged venv only imports on build machines that happen to
# have the redistributable. Raise the floor here and pin the matching lock
# entry so uv sync keeps the receipt's uv.lock digest stable instead of
# re-resolving it. assemble-backend verifies the real native import plus the
# shipped _greenlet*.pyd before accepting a payload. Existing packaged installs
# need the updated payload; source installs must rerun
# scripts/jiuwenswarm.mjs setup (or jiuwenswarm.sh setup).
diff --git a/pyproject.toml b/pyproject.toml
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -30,7 +30,7 @@
     "dingtalk-stream>=0.24.3,<0.25",
     "wecom-aibot-sdk>=1.0.5,<2",
     "python-socks>=2.8.1,<3",
-    "greenlet>=3.3.2,<4",
+    "greenlet>=3.5.5,<4",
     "skillnet-ai==0.0.16",
     "mutagen>=1.47.0,<2",
     "google-genai>=1.68.0,<2",
@@ -78,7 +78,7 @@
     "dingtalk-stream>=0.24.3",
     "wecom-aibot-sdk>=1.0.5",
     "python-socks>=2.8.1",
-    "greenlet>=3.3.2",
+    "greenlet>=3.5.5",
     "skillnet-ai==0.0.16",
     "mutagen>=1.47.0",
     "google-genai>=1.68.0",

diff --git a/uv.lock b/uv.lock
--- a/uv.lock
+++ b/uv.lock
