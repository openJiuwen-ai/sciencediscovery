{
  "mcpServers": {
    "llm-wiki": {
      "command": "python",
      "args": ["-m", "sciencediscovery_gateway.llm_wiki_mcp"],
      "description": "Read-only LLM Wiki knowledge base for any domain",
      "enabled": true,
      "env": {
        "SCIENCE_AGENT_LLM_WIKI_URL": "$SCIENCE_AGENT_LLM_WIKI_URL",
        "SCIENCE_AGENT_LLM_WIKI_TOKEN": "$SCIENCE_AGENT_LLM_WIKI_TOKEN"
      },
      "tool_call_timeout": 60,
      "type": "stdio"
    },
    "biomed": {
      "args": [
        "-m",
        "sciencediscovery_gateway.public_biomed_mcp"
      ],
      "command": "python",
      "description": "Public biomedical literature, structure, genomics, pathway, variation, chemistry, and dataset APIs",
      "enabled": true,
      "routing": {
        "keywords": [],
        "mode": "off",
        "priority": 0
      },
      "tool_call_timeout": 60,
      "type": "stdio"
    },
    "uniprot": {
      "args": [
        "-m",
        "sciencediscovery_gateway.uniprot_mcp"
      ],
      "command": "python",
      "description": "Governed UniProtKB protein records and sequence artifact preparation",
      "enabled": true,
      "routing": {
        "keywords": [
          "UniProt",
          "protein",
          "accession",
          "amino acid sequence",
          "gene product"
        ],
        "mode": "prefer",
        "priority": 90
      },
      "tool_call_timeout": 30,
      "type": "stdio"
    }
  },
  "skills": {}
}
