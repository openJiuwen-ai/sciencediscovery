{
  "name": "@sciencediscovery/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./dist/runtime.js"
    },
    "./views": {
      "types": "./src/views.ts",
      "default": "./dist/views.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.1.1"
  },
  "dependencies": {
    "@sciencediscovery/context": "workspace:*",
    "@sciencediscovery/tools": "workspace:*",
    "@sciencediscovery/runtime-core": "workspace:*"
  }
}
